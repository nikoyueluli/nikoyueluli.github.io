---
import '../styles/global.css';
import { copy, profile, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  page: 'home' | 'about' | 'publications' | 'projects';
  title?: string;
  description?: string;
}

const { lang, page, title, description } = Astro.props;
const t = copy[lang];
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const route = page === 'home' ? '' : page;
const otherLang = lang === 'en' ? 'zh' : 'en';
const pageTitle = title ? `${title} — Yuelu Li` : 'Yuelu Li — Computational Media and Arts';
const pageDescription = description || t.intro;
const path = (targetLang: Lang, targetPage = route) => `${base}${targetLang}/${targetPage}`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f8f7f4" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}images/yuelu-li.jpg`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(path(lang), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(path('en'), Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(path('zh'), Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : '跳至正文'}</a>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="wordmark" href={path(lang)} aria-label={lang === 'en' ? 'Yuelu Li home' : '李玥璐首页'}>
          <span class="wordmark-en">Yuelu Li</span>
          <span class="wordmark-zh">李玥璐</span>
        </a>
        <nav class="main-nav" aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
          {Object.entries(t.nav).map(([key, label]) => (
            <a href={path(lang, key === 'home' ? '' : key)} aria-current={page === key ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <a
          class="language-switch"
          href={path(otherLang)}
          data-lang={otherLang}
          aria-label={lang === 'en' ? '切换至中文' : 'Switch to English'}
        >
          {lang === 'en' ? '中文' : 'EN'}
        </a>
        <button class="menu-button" aria-label={lang === 'en' ? 'Open menu' : '打开菜单'} aria-expanded="false">
          <span></span><span></span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-name">{profile.name[lang]}</p>
          <p>{t.footer}</p>
        </div>
        <div class="footer-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a>
        </div>
        <p class="copyright">© {new Date().getFullYear()} {profile.name[lang]}</p>
      </div>
    </footer>
    <script is:inline define:vars={{ currentLang: lang }}>
      const menu = document.querySelector('.menu-button');
      const nav = document.querySelector('.main-nav');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') === 'true';
        menu.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      document.querySelector('.language-switch')?.addEventListener('click', (event) => {
        const target = event.currentTarget;
        localStorage.setItem('preferred-language', target.dataset.lang);
      });
      document.documentElement.dataset.ready = 'true';
    </script>
  </body>
</html>
