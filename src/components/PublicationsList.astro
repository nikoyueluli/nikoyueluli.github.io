---
import type { Publication } from '../data/publications';
import type { Lang } from '../data/site';

interface Props { publications: Publication[]; lang: Lang; compact?: boolean; }
const { publications, lang, compact = false } = Astro.props;
---

<div class:list={['publication-list', { compact }]}>
  {publications.map((publication, index) => (
    <article class="publication-item">
      <div class="publication-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
      <div>
        <p class="publication-meta">{publication.date} · {publication.venue}</p>
        <h2 class="publication-title">{publication.title}</h2>
        <p class="publication-authors">
          {publication.authors.map((author, authorIndex) => (
            <><span class:list={{ 'author-self': author === 'Yuelu Li' }}>{author}</span>{authorIndex < publication.authors.length - 1 ? ', ' : ''}</>
          ))}
        </p>
        <div class="publication-links">
          {publication.pages && <span>{lang === 'en' ? 'pp.' : '页码'} {publication.pages}</span>}
          {publication.doi && <a href={publication.doi} target="_blank" rel="noreferrer">DOI ↗</a>}
        </div>
      </div>
    </article>
  ))}
</div>
