---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Yuelu Li</title></head><body><p>Redirecting…</p><script is:inline define:vars={{ base }}>const saved = localStorage.getItem('preferred-language'); const lang = saved === 'zh' ? 'zh' : 'en'; window.location.replace(`${base}${lang}/`);</script></body></html>
